# === App ===
APP_ENV=dev
APP_DEBUG=true

# === Security ===
JWT_SECRET=your-secret-key-here-change-in-production

# === Rust Engine ===
RUST_ENGINE_URL=http://rust-engine:8090
RUST_ENGINE_INTERNAL_TOKEN=your-internal-token-here

# === MySQL ===
MYSQL_HOST=mysql
MYSQL_DB=archivio_parlante_x
MYSQL_USER=root
MYSQL_PASSWORD=

# === Redis ===
REDIS_URL=redis://redis:6379

# === Rate Limiting (Fase 3.3) ===
# Login endpoint
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900

# Register endpoint
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600

# Refresh endpoint
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW=900
