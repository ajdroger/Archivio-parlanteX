# ============================================================================
# Archivio Parlante — Python Worker Configuration Example
# ============================================================================
# Copy to .env and fill with actual values
# NEVER commit .env to git

# === App Environment ===
APP_ENV=dev
APP_DEBUG=true

# === CORS Origins ===
# Default: ["http://localhost:3000", "http://localhost:5173"]
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# === API Communication ===
RUST_ENGINE_URL=http://localhost:8090
RUST_ENGINE_INTERNAL_TOKEN=your_rust_engine_token_here

# === Shared Storage ===
SHARED_UPLOADS_PATH=C:/Users/aj_93/OneDrive/Documenti/GitHub/Archivio-parlanteX/shared/uploads
MAX_UPLOAD_SIZE_MB=200

# === OCR ===
TESSERACT_LANG=ita+eng
OCR_DPI=300

# === Parsing ===
PDF_MAX_PAGES=500
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# === Reranker (Fase 2.2) ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_TOP_K=5

# === Contextual Retrieval (Fase 2.3) ===
OLLAMA_URL=http://localhost:11434
CONTEXTUALIZATION_MODEL=qwen2.5:3b-instruct-q4_K_M
CONTEXTUALIZATION_BATCH_SIZE=5
CONTEXTUALIZATION_MAX_DOC_LENGTH=8000

# === Knowledge Graph (Fase 2.4) ===
KG_SPACY_MODEL=it_core_news_lg
KG_MAX_TEXT_LENGTH=50000
