# ============================================================================
# Archivio Parlante — Environment Configuration
# ============================================================================
# Copy to .env and fill with actual values
# NEVER commit .env to git (in .gitignore)

# === App Environment ===
APP_ENV=dev                                 # dev | staging | production
APP_DEBUG=true                              # NEVER true in production
APP_NAME="Archivio Parlante"                # Quotes required for dotenvy parser

# === Security Secrets ===
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_HEX_CHARS_MIN
# Generate with: openssl rand -hex 64
RUST_ENGINE_INTERNAL_TOKEN=CHANGE_ME_64_HEX_CHARS_FOR_PHP_TO_RUST_AUTH

# === Porte host vs rete Docker (coexistence archivio-parlante-starter) ===
# Variabili sotto = URL tra container su archivio_net.
# Dal host Windows: PHP :9080 | MySQL :3307 | Redis :6380 | Qdrant :6335 | Rust :8090
# NON usare su host: 8080, 3306, 6379, 6333 (riservate allo starter AMPPS).
# Dettaglio: docs/PORTS_COEXISTENCE.md

# === MySQL Database ===
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=archivio_parlante_x               # VINCOLANTE: già creato via phpMyAdmin
MYSQL_USER=root
MYSQL_PASSWORD=                             # Empty for dev, SET IN PRODUCTION
MYSQL_ROOT_PASSWORD=                        # Empty for dev, SET IN PRODUCTION

# === Qdrant Vector Database (interno: 6333 REST; host: localhost:6335) ===
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_PORT=6334

# === Ollama (LLM Locale - Default Zero-Cost) ===
OLLAMA_URL=http://ollama:11434

# Default models (8 GB VRAM compatible)
OLLAMA_MODEL_CHAT=qwen2.5:7b-instruct-q4_K_M          # ~4.7 GB VRAM, default chat
OLLAMA_MODEL_CHAT_SMALL=qwen2.5:3b-instruct-q4_K_M    # ~2.0 GB VRAM, massive tasks
OLLAMA_MODEL_CHAT_HEAVY=qwen2.5:14b-instruct-q4_K_M   # ~9 GB VRAM, optional CPU offload
OLLAMA_MODEL_EMBED=nomic-embed-text                   # ~0.3 GB VRAM, 768 dim

# === Internal Services ===
RUST_ENGINE_URL=http://rust-engine:8090
PYTHON_WORKER_URL=http://python-worker:8091
REDIS_URL=redis://redis:6379

# === Provider Cloud OPT-IN (lasciare vuoti per default zero-cost) ===
# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=

# DeepSeek
DEEPSEEK_API_KEY=

# Qwen (Alibaba Cloud)
QWEN_API_KEY=

# Moonshot (Kimi)
MOONSHOT_API_KEY=

# Zhipu (GLM)
ZHIPU_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter (aggregator)
OPENROUTER_API_KEY=

# Together.ai
TOGETHER_API_KEY=

# Fireworks.ai
FIREWORKS_API_KEY=

# === Budget Guard (Zero-Cost Enforcement) ===
DAILY_COST_BUDGET_EUR=0.00                 # Default ZERO: provider a pagamento bloccati
MONTHLY_COST_BUDGET_EUR=0.00               # Admin deve alzare da UI per abilitare cloud

# === Storage & Uploads ===
SHARED_UPLOADS_PATH=/shared/uploads
MAX_UPLOAD_SIZE_MB=200
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown

# === Chunking & RAG Tuning ===
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_PERCENT=15
TOP_K_DENSE=30
TOP_K_SPARSE=30
TOP_K_RERANK=5
HYBRID_FUSION_K=60                         # RRF k parameter

# === Concurrency Limits ===
MAX_CONCURRENT_EMBEDDINGS=16
MAX_CONCURRENT_LLM_CALLS=8
MAX_CONCURRENT_UPLOADS=3

# === Logging ===
LOG_LEVEL=info                             # debug | info | warn | error
RUST_LOG=info,rust_engine=debug           # Rust tracing filter
PYTHON_LOG_LEVEL=INFO

# === Development Only (REMOVE IN PRODUCTION) ===
ENABLE_CORS=true                           # Allow CORS for dev frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:9080
